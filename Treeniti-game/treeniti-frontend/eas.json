{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "credentialsSource": "local"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "credentialsSource": "local",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://treenitiofficial1.onrender.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
